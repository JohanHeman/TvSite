@page "/"
@using TvSite.Domain.InterfacesAPI.Services
@using TvSite.Domain.Entities.Api
@rendermode InteractiveServer
@inject IAPIService apiService

<PageTitle>Home</PageTitle>

<h1>Welcome</h1>

<h3 style="text-align: center">Discover Tv shows</h3>
<div class="d-flex flex-wrap gap-3">
    @foreach (var show in tvShows)
    {
        <div style="width: 12rem;">
            <a href="/tvshow?mediaid=@show.Id">
                <img src="@(string.IsNullOrWhiteSpace(show.Image) || show.Image == "https://image.tmdb.org/t/p/w154" ? "/images/img_not_available.png" : show.Image)" height="231"/>
                <p>@show.Name</p>
            </a>
        </div>
    }
</div>

@code{
    List<DisplayMedia> tvShows = new List<DisplayMedia>();
    
    protected override async Task OnInitializedAsync()
    {
        tvShows = await apiService.GetTvShowsFromDiscover();
    }
}
