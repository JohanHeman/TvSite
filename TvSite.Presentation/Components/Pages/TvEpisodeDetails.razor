@page "/tvshow/season/episode"
@using Microsoft.AspNetCore.Identity
@using TvSite.Domain.Entities
@using TvSite.Domain.Entities.DbModels
@using TvSite.Domain.Interfaces.Services
@using TvSite.Domain.InterfacesAPI.Services
@inject IAPIService ApiService;
@inject IRatingService RatingService
@inject ICommentService CommentService
@inject IWatchedEpisodeService WatchedEpisodeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer


<h3>TvEpisodeDetails</h3>
@if (_tvEpisodeDetails != null)
{
    // episode information
    <div>
        <h3>
            @_tvEpisodeDetails.Title
        </h3>
        <div>
            <img src="@_tvEpisodeDetails.ImagePath"/> 
        </div>

        <AuthorizeView>
            <Authorized>
                @if (!_isWatchedEpisode)
                {
                    <button @onclick="async () => await SetEpisodeAsWatchedAsync()" class="btn btn-outline-success">Not watched</button>
                }
                else
                {
                    <button @onclick="async () => await DeleteWatchedEpisodeAsync()" class="btn btn-success">Watched</button>
                }
            </Authorized>
            <NotAuthorized>
                <a href="/Account/Login" class="btn btn-outline-success">Login to mark as watched</a>
            </NotAuthorized>
        </AuthorizeView>

        <div>
            <p>@_tvEpisodeDetails.EpisodeNumber</p>
            <p>Airdate: @_tvEpisodeDetails.AirDate</p>
            @if (_rating != null)
            {
                <p>Rating: @_rating</p>
            }
        </div>
        <div>
            <p>Description</p>
            <p>@_tvEpisodeDetails.Description</p>
        </div>
    </div>
}
    
<!--comment section-->
<AuthorizeView>
    <Authorized>   
        <div>
            <input @bind="_comment"/>
            <button onclick=@CreateCommentAsync(_comment)
            >Add comment</button>
        </div>
    </Authorized>
</AuthorizeView>
@foreach (var comment in _comments)
{
    <div>
        @comment.ApplicationUser.DisplayName
        @comment.Text
    </div>
}

@code {
    //loading the page
    private TvSeriesEpisode _tvEpisodeDetails;

    [SupplyParameterFromQuery]
    public int SeasonNumber { get; set; }

    [SupplyParameterFromQuery]
    public string ShowId { get; set; }

    [SupplyParameterFromQuery]
    public int EpisodeNumber { get; set; }

    private string _loadedShowId;

    private double? _rating = null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedShowId == ShowId) return;

        _loadedShowId = ShowId;

        _tvEpisodeDetails = await ApiService.GetEpisodeDetails(_loadedShowId, SeasonNumber, EpisodeNumber);
        _rating = await RatingService.GetAverageRatingByMediaIdAsync(_tvEpisodeDetails.Id);
        _comments = await CommentService.GetCommentsByMediaIdAsync(_tvEpisodeDetails.Id.ToString());

        var user = await GetUser();
        if (user != null)
            _isWatchedEpisode = await WatchedEpisodeService.GetIsWatchedEpisodeByUserAsync(_tvEpisodeDetails.Id, user.Id);
    }

    //comment
    private IReadOnlyList<Comment> _comments = new List<Comment>();
    private string _comment = "";

    private async Task CreateCommentAsync(string commentText)
    {
        var user = await GetUser();
        if (user == null) return;

        var comment = new Comment()
        {
            Id = Guid.NewGuid(),
            Text = commentText,
            ApplicationUserId =  user.Id,
            MediaId = _tvEpisodeDetails.Id
        };

        await CommentService.CreateCommentAsync(comment);
    }

    private async Task<ApplicationUser?> GetUser()
    {
        var myAuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(myAuthState.User);
    }

    private bool _isWatchedEpisode;
    private async Task SetEpisodeAsWatchedAsync()
    {
        var user = await GetUser();
        if (user == null || _tvEpisodeDetails == null) return;

        // Add to Db
        await WatchedEpisodeService.CreateWatchedEpisode(user.Id, _tvEpisodeDetails.Id);

        // Refresh bool
        _isWatchedEpisode = await WatchedEpisodeService.GetIsWatchedEpisodeByUserAsync(_tvEpisodeDetails.Id, user.Id);
    }

    private async Task DeleteWatchedEpisodeAsync()
    {
        var user = await GetUser();
        if (user == null || _tvEpisodeDetails == null) return;

        await WatchedEpisodeService.DeleteWatchedEpisode(_tvEpisodeDetails.Id, user.Id);

        // Refresh bool
        _isWatchedEpisode = await WatchedEpisodeService.GetIsWatchedEpisodeByUserAsync(_tvEpisodeDetails.Id, user.Id);
    }
}