@page "/tvshow/season/episode"
@using Microsoft.AspNetCore.Identity
@using TvSite.Domain.Entities.Api
@using TvSite.Domain.Entities.Database
@using TvSite.Application.Interfaces.Services
@using TvSite.Application.Interfaces.ApiService
@inject IAPIService ApiService;
@inject IRatingService RatingService
@inject ICommentService CommentService
@inject IWatchedEpisodeService WatchedEpisodeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

@* Navigation links *@
<div class="mb-2">
    @if (_tvEpisodeDetails != null)
    {
        <a href="/">Home</a>
        <a>/</a>
        <a href="/tvShow?MediaId=@ShowId">Tv Show</a>
        <a>/</a>
        <a href="/tvshow/season?ShowId=@ShowId&SeasonNumber=@_tvEpisodeDetails.SeasonNumber">Season</a>
    }
    else
    {
        <a href="/">Home</a>
    }
</div>


<h2>Episode details</h2>
@if (_tvEpisodeDetails != null)
{
    // episode information
    <div>
        <h3>@_tvEpisodeDetails.Title</h3>
        <p class="mb-0">Ep: @_tvEpisodeDetails.EpisodeNumber</p>
        <div>
            <img src="@(string.IsNullOrWhiteSpace(_tvEpisodeDetails.ImagePath) || _tvEpisodeDetails.ImagePath == "https://image.tmdb.org/t/p/w300" ? "/images/img_not_available.png" : _tvEpisodeDetails.ImagePath)" height="169"/>
        </div>

        @* Add episode as watched buttons *@
        <div class="my-2">
            <AuthorizeView>
                <Authorized>
                    @{
                        string _btnWatchedText = _isWatchedEpisode ? "Watched" : "Not watched";
                        string _btnWatchedClass = _isWatchedEpisode ? "btn btn-success" : "btn btn-outline-success";
                    }

                    <button @onclick="async () => await CreateOrDeleteWatchedEpisode()" class="@_btnWatchedClass">@_btnWatchedText</button>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login" class="btn btn-outline-success">Login to mark as watched</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>


        @* Display episode information *@
        <div class="mb-3">
            <div>
                <h4 class="mb-0">Airdate</h4>
                <p>@_tvEpisodeDetails.AirDate</p>
            </div>
            
            <div>
                <h4 class="mb-0">Description</h4>
                <p>@_tvEpisodeDetails.Description</p>
            </div>
            
            @if (_rating != null)
            {
                <div>
                    <p>User ratings: @_rating</p>
                    <label class="form-label">Rating amount:</label>
                    <InputNumber TValue="int" @bind-Value="_userStars" Placeholder="Enter amount" class="form-control mb-2" />
                    
                    <button @onclick="async () => await CreateUserRatingAsync()" class="btn btn-primary">Rate</button>
                </div>                
            }
        </div>

    </div>
}
    
@* Add comment *@
<div class="mb-3">
    <AuthorizeView>
        <Authorized>
            <div>
                <input @bind="_comment" class="form-control form-text mb-2"/>
                <button @onclick=" async () => await CreateCommentAsync()" class="btn btn-primary">
                    Add comment
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@* Draw comments *@
@foreach (var comment in _comments)
{
    <div class="comment-bg p-1 my-2 border border-1 border-white">
        <p class="m-0">@comment.DateTime.ToString("yyyy-MM-dd HH:mm")</p>
        <p>
            @comment.ApplicationUser.DisplayName:
            @comment.Text
        </p>
    </div>
}

@code {
    //loading the page
    private TvSeriesEpisode _tvEpisodeDetails;

    [SupplyParameterFromQuery]
    public int SeasonNumber { get; set; }

    [SupplyParameterFromQuery]
    public string ShowId { get; set; }

    [SupplyParameterFromQuery]
    public int EpisodeNumber { get; set; }

    private string _loadedShowId;

    private double? _rating = null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedShowId == ShowId) return;

        _loadedShowId = ShowId;

        _tvEpisodeDetails = await ApiService.GetEpisodeDetails(_loadedShowId, SeasonNumber, EpisodeNumber);

        if (_tvEpisodeDetails != null && !string.IsNullOrWhiteSpace(_tvEpisodeDetails.Id))
        {
            _rating = await RatingService.GetAverageRatingByEpisodeMediaIdAsync(_tvEpisodeDetails.Id);
            _comments = await CommentService.GetCommentsByEpisodeMediaIdAsync(_tvEpisodeDetails.Id);
        

            var user = await GetUser();
            if (user != null)
                _isWatchedEpisode = await WatchedEpisodeService.IsWatchedEpisodeByUserAsync(_tvEpisodeDetails.Id, user.Id);
        }
    }

    //comment
    private IReadOnlyList<Comment> _comments = new List<Comment>();
    private string _comment = "";

    private async Task CreateCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_comment)) return;

        var user = await GetUser();
        if (user == null || _tvEpisodeDetails == null) return;

        var dateTime = DateTime.Now;

        // Upload comment to db
        await CommentService.CreateCommentAsync(_comment, _tvEpisodeDetails.Id, user.Id, dateTime);

        // Reset input and get updated comment list
        _comment = "";
        _comments = await CommentService.GetCommentsByEpisodeMediaIdAsync(_tvEpisodeDetails.Id);
    }

    private async Task<ApplicationUser?> GetUser()
    {
        var myAuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(myAuthState.User);
    }

    private bool _isWatchedEpisode;
    private async Task CreateOrDeleteWatchedEpisode()
    {
        var user = await GetUser();
        if (user == null || _tvEpisodeDetails == null) return;

        // Creates or deletes the WatchedEpisode in the DB. Depending on if it exists
        await WatchedEpisodeService.CreateOrDeleteWatchedEpisode(_tvEpisodeDetails.Id, user.Id, ShowId, _tvEpisodeDetails.SeasonNumber, _tvEpisodeDetails.EpisodeNumber);

        // Refresh bool
        _isWatchedEpisode = await WatchedEpisodeService.IsWatchedEpisodeByUserAsync(_tvEpisodeDetails.Id, user.Id);
    }
    
    // rating 
    private int _userStars;

    private async Task CreateUserRatingAsync()
    {
        var user = await GetUser();
        if (user == null || _tvEpisodeDetails == null) return;
        var existingRating = await RatingService.GetRatingByIdAsync(_tvEpisodeDetails.Id, user.Id);
        if (existingRating != null)
        {
            await RatingService.UpdateRatingAsync(existingRating, _userStars);
        }
        else
        {
            await RatingService.CreateRatingAsync(_userStars, _tvEpisodeDetails.Id, user.Id);
        } 
        _rating = await RatingService.GetAverageRatingByEpisodeMediaIdAsync(_tvEpisodeDetails.Id);
    }
}
