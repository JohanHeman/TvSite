@page "/tvshow/season"
@using TvSite.Domain.Entities.Api
@using TvSite.Domain.InterfacesAPI.Services
@rendermode InteractiveServer

@inject IAPIService ApiService

@* Navigation links *@
<div class="mb-2">
    @if (_season != null)
    {
        <a href="/">Home</a>
        <a>/</a>
        <a href="/tvShow?MediaId=@ShowId">Tv Show</a>
    }
    else
    {
        <a href="/">Home</a>
    }
</div>


@* Display Season details *@
<h3>Season</h3>
@if(_season != null)
{
    <h1>@_season.SeasonName</h1>
    <div class="d-flex gap-3 mb-4">
        <img src="@(string.IsNullOrWhiteSpace(_season.ImagePath) || _season.ImagePath == "https://image.tmdb.org/t/p/w154" ? "/images/img_not_available.png" : _season.ImagePath)" height="231"/>
        <p>@_season.Description</p>
    </div>

    @* Display season episodes *@
    <h1>Episodes</h1>
    <div class="d-flex flex-column gap-3">
        @foreach (var episode in _season.Episodes)
        {
            <a href="/tvshow/season/episode?ShowId=@ShowId&SeasonNumber=@_season.SeasonNumber&EpisodeNumber=@episode.EpisodeNumber">
                <div class="d-flex border border-1 p-1 gap-3">
                    <div>
                        <p>Episode: @episode.EpisodeNumber</p>
                        <img src="@(string.IsNullOrWhiteSpace(episode.ImagePath) || episode.ImagePath == "https://image.tmdb.org/t/p/w92" ? "/images/img_not_available.png" : episode.ImagePath)" height="52"/>
                    </div>
                    <div>

                        <p>@episode.Title | @episode.AirDate</p>
                        <p>@episode.Description</p>
                    </div>
                </div>
            </a>        
        }
    </div>
}

@code {
    private TvSeriesSeason _season;

    [SupplyParameterFromQuery] public int SeasonNumber { get; set; }

    [SupplyParameterFromQuery] public string ShowId { get; set; } = "";

    // Vars for preventing calling the api multiple times
    private int _loadedSeasonNumber;
    private string? _loadedShowId;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ShowId))
            return;

        // Prevent loading calling the api twice. OnParametersSetAsync can triggers multiple times
        if (_loadedShowId == ShowId && _loadedSeasonNumber == SeasonNumber)
            return;

        _loadedShowId = ShowId;
        _loadedSeasonNumber = SeasonNumber;

        _season = await ApiService.GetSeasonDetails(ShowId, SeasonNumber);
    }
}