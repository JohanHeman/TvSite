@page "/tvshow"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using TvSite.Domain.Entities.Api
@using TvSite.Domain.Entities.Database
@using TvSite.Domain.Enums
@using TvSite.Domain.Interfaces.Services
@using TvSite.Domain.InterfacesAPI.Services

@inject IAPIService ApiService
@inject IMediaListEntryService MediaListEntryService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Details</h3>

@if(_tvSeries != null)
{
    <div>
        <h1>@_tvSeries.Name</h1>
        <p>@_tvSeries.Description</p>
        <img src='@_tvSeries.MediaImage' class="mb-1" />
    </div>

    <div>
        <h4>Directors</h4>
        <p>
            @foreach (var director in _tvSeries.Directors)
            {
                @director
                <br />
            }
        </p>
    </div>

    <AuthorizeView>
        <Authorized>
            @if (_isFollowing == true)
            {
                <button class="btn btn-light" @onclick="async () => await UpdateFollowingListAsync(ListStateEnum.ListState.StoppedWatching)">
                    Unfollow
                </button>
            }
            else
            {
                <button class="btn btn-light" @onclick="async () => await AddToListAsync(ListStateEnum.ListState.Following)">
                    Follow
                </button>
            }
            <button class="btn btn-light" @onclick="async () => await AddToListAsync(ListStateEnum.ListState.ToBeWatched)">
                Watch Later
            </button>
        </Authorized>
        <NotAuthorized>
            <button class="btn btn-outline-danger" disabled>
                Loggin to Follow
            </button>
            <button class="btn btn-outline-danger" disabled>
                Loggin to add to watch later
            </button>
        </NotAuthorized>
    </AuthorizeView>

    <div>
        <h2>Seasons</h2>
        <div class="d-flex flex-column gap-2">
            @foreach (var season in _tvSeries.Seasons)
            {
                <a href="/tvshow/season?ShowId=@_tvSeries.Id&SeasonNumber=@season.SeasonNumber">
                <div class="border border-1 p-2">
                    <div class="d-flex gap-2">
                        <p>@season.SeasonName</p>
                        <p>@season.AirDate</p>
                        <p>Episodes: @season.EpisodeCount</p>
                    </div>

                    <div class="mb-1 d-flex gap-2">
                        <img src="@season.ImagePath"/>
                        <p>@season.Description</p>
                    </div>
                </div>
                </a>
            }
        </div>
    </div>

}

@code {
    [SupplyParameterFromQuery]
    public string MediaId { get; set; } = "";

    private TvSeries _tvSeries = null!;

    private bool _isFollowing;

    protected override async Task OnParametersSetAsync()
    {
        _tvSeries = await ApiService.GetTvShowDetailsById(MediaId);

        var user = await GetUser();

        if(user != null)
        {
            var followingList = await MediaListEntryService.GetMediaListByUserIdAsync(user.Id, ListStateEnum.ListState.Following);
            // Checking if the tvshow is in the FollowingList. 
            // If the tvshow is in the followingList - button switches to "unfollow"
            _isFollowing = followingList.Any(mediaListEntry => mediaListEntry.MediaId == MediaId);
        }
    }

    private async Task AddToListAsync(ListStateEnum.ListState listState)
    {
        var user = await GetUser();

        if (user == null || string.IsNullOrWhiteSpace(MediaId)) return;

        // Create new MediaListEntry
        var mediaListEntry = new MediaListEntry
        {
            MediaId = MediaId,
            ListState = (int)listState,
            ApplicationUserId = user.Id
        };
        await MediaListEntryService.CreateMediaListEntryAsync(mediaListEntry);

        // If user clicks on follow button _isFollowing becomes true and the button switches to unfollow button.
        if (listState == ListStateEnum.ListState.Following)
        {
            _isFollowing = true;
        }
    }

    private async Task UpdateFollowingListAsync(ListStateEnum.ListState listState)
    {
        var user = await GetUser();

        if (user == null || string.IsNullOrWhiteSpace(MediaId)) return;

        // Update liststate from following or stop watching
        await MediaListEntryService.UpdateMediaListEntryStateAsync(user.Id, MediaId, listState);
        
        _isFollowing = false;
    }

    private async Task<ApplicationUser?> GetUser()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(authenticationState.User);
    }
}
