@using Microsoft.AspNetCore.Identity
@using TvSite.Application.Service
@using TvSite.Domain.Entities.Api
@using TvSite.Domain.Entities.Database
@using TvSite.Domain.Enums
@using TvSite.Domain.Interfaces.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IMediaListEntryService MediaListEntryService
@rendermode InteractiveServer

<div class="mb-3">
    <h3>@ListName</h3>

    <div class="d-flex flex-wrap gap-3">
        @if (_isShowingFullList)
        {
            @foreach (var tvShow in TvShowList)
            {
                <div style="width: 12rem;">
                    <a href="/tvshow?mediaid=@tvShow.Id">
                        <img src="@tvShow.MediaImage" />
                        <p>@tvShow.Name</p>
                    </a>
                    <button class="btn btn-danger" @onclick="() => DeleteTvShowFromListAsync(tvShow.Id)">
                        Remove
                    </button>
                </div>
            }
        }
        else
        {
            @foreach (var tvShow in TakeFourList)
            {
                <div style="width: 12rem;">
                    <a href="/tvshow?mediaid=@tvShow.Id">
                        <img src="@tvShow.MediaImage" />
                        <p>@tvShow.Name</p>
                    </a>
                    <button class="btn btn-danger" @onclick="() => DeleteTvShowFromListAsync(tvShow.Id)">
                        Remove
                    </button>
                </div>
            }
        }
    </div>
    <button @onclick="ToggleShowFullList" class="btn btn-primary">Expand / Minimize</button>
</div>



@code {
    [Parameter]
    public string ListName { get; set; } = "";

    [Parameter]
    public List<TvSeries> TvShowList { get; set; } = new();

    [Parameter]
    public ListStateEnum.ListState ListState { get; set; }

    private bool _isShowingFullList;
    private List<TvSeries> TakeFourList => TvShowList.Take(4).ToList();

    private void ToggleShowFullList()
    {
        _isShowingFullList = !_isShowingFullList;
    }

    private async Task DeleteTvShowFromListAsync(string mediaId)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authenticationState.User);

        if(user != null)
        {
            await MediaListEntryService.DeleteMediaListEntryAsync(user.Id, mediaId, ListState);
            var tvShowToBeDeleted = TvShowList.FirstOrDefault(tvShowRemoved => tvShowRemoved.Id == mediaId);

            if(tvShowToBeDeleted != null)
            {
                TvShowList.Remove(tvShowToBeDeleted);
            }
        }
    }
}
